# Secrets — never commit (Botkeep + GitHub)
.env
.env.*
!.env.example
*.pem
*.key

# Node build output & deps
node_modules/
dist/

# Legacy PHP version — archived locally, not tracked
php-legacy/

# Local data (attendance, roster, messages) — never commit
/data/

# Accidental artifacts that shouldn't be in a repo
/*.log
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.lock

# Editor / OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db

# Temp image files generated by ImageSender
*.tmp

# AI tool history / caches locally only
.aider*
.claude/
