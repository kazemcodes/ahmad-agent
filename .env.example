BALE_TOKEN=
ADMIN_IDS=
BOT_USERNAME=
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
IMAGE_PROVIDER=openai
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=
CLOUDFLARE_ACCOUNT_ID=
WEBHOOK_SECRET=
TIMEZONE=Asia/Tehran
CHAT_RATE_LIMIT=10
IMAGE_RATE_LIMIT=5
# Multi-process mode (recommended): separate poller + fast worker + image workers.
# Just run: php bin/poll.php  and  php bin/image-worker.php  (one per slot).
# IMAGE_WORKERS is advisory for process managers (systemd/supervisor/pm2);
# each image-worker process takes one slot lock, so run IMAGE_WORKERS of them.
IMAGE_WORKERS=2
# Legacy single-process mode only: set to 1 if you run just `php bin/poll.php`
# with no image-worker process and want it to also drain the image queue.
POLL_INLINE_IMAGES=0
VISION_MODEL=
VOICE_MODEL=
VOICE_BASE_URL=
VOICE_API_KEY=
BRAVE_SEARCH_API_KEY=
AI_HISTORY_TURNS=6
AI_HISTORY_CHARS=3000
AI_MESSAGE_CHARS=4000
AI_MAX_OUTPUT_TOKENS=300
GEMINI_IMAGE_API_KEY=
GEMINI_IMAGE_MODEL=
